{
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "npm run test:app && npm run test:db",
    "test:app": "jest",
    "test:db": "node --test supabase/tests/db.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app src __tests__ supabase/tests"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "name": "rotafit",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2",
    "@tanstack/react-query": "^5",
    "base64-js": "1.5.1",
    "expo": "57.0.33",
    "expo-constants": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.14",
    "expo-router": "~57.0.31",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-svg": "15.15.4",
    "expo-blur": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-auth-session": "~57.0.17",
    "expo-web-browser": "~57.0.3",
    "expo-crypto": "~57.0.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3",
    "typescript": "~6.0.0"
  }
}
